# ============================================================
# TrendCrafter AI · 私有部署环境变量模板
# 用法：复制本文件为 .env，填入对应的凭据；.env 已被 .gitignore 严格排除
# ============================================================

# --- 平台级管理员账号（首次启动时生效，变更需重启）---
# 用于初始化平台级超级管理员账号（13800138000），部署时务必设置为强密码
# 未配置时系统将自动生成一次性随机密码（见启动日志），但无法通过登录页直接使用
ADMIN_PASSWORD=

# --- 多模态 AI 管线接入（可选，不配置自动降级为本地静态演示）---
# 通义 DashScope（Qwen-VL 多模态打标 + Embedding + 通义万相生图）
DASHSCOPE_API_KEY=

# OCR.space（图片文字识别，备用；未配置时走 DashScope OCR 降级）
OCRSPACE_API_KEY=

# Qdrant 向量检索服务（云服务或本地自部署）
QDRANT_URL=
QDRANT_API_KEY=
